# =====================================================================
#  IPNET Billetterie — configuration locale
#  Copiez ce fichier en « .env » (même dossier) et complétez les valeurs.
#  Une ligne commentée (#) garde le comportement par défaut ; décommentez-la pour la renseigner.
#  Le fichier .env n'est jamais versionné. Aucune valeur n'est inventée :
#  laissez vide ce que vous ne connaissez pas encore.
# =====================================================================

# --- Base de données PostgreSQL (obligatoire) ---
DB_URL=jdbc:postgresql://localhost:5432/ipnet_db
DB_USERNAME=postgres
# DB_PASSWORD=

# --- Messagerie Brevo (obligatoire : codes de vérification, billets, notifications) ---
# Mode API (recommandé en hébergement, ports SMTP bloqués) : clé API « xkeysib-… » de Brevo
BREVO_API_KEY=
# Mode SMTP : identifiants du relais Brevo (SMTP et API > Clés SMTP)
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
# Adresse d'expédition affichée : doit être un expéditeur validé dans Brevo
# MAIL_EXPEDITEUR=

# --- Secrets (obligatoires en production : chaînes aléatoires d'au moins 64 caractères) ---
# JWT_SECRET=
# QR_HMAC_SECRET=

# --- Administrateur initial (facultatif) ---
# Laissez vide : au premier lancement, un code d'installation s'affiche et la page /installation
# permet de créer l'administrateur depuis le navigateur.
# ADMIN_EMAIL=
# ADMIN_TELEPHONE=
# ADMIN_PASSWORD=

# --- Numéro Mobile Money de réception des paiements (facultatif ici) ---
# Se saisit normalement dans Administration > Paramètres.
# PAIEMENT_NUMERO=
# PAIEMENT_TITULAIRE=

# --- Téléphones (métadonnées libphonenumber) ---
# Région des saisies sans indicatif (TG = Togo, +228) et pays acceptés (vide = tous)
TELEPHONE_REGION=TG
# TELEPHONE_REGIONS_AUTORISEES=

# --- Front-end ---
FRONT_URL=http://localhost:5173
CORS_ORIGINES=http://localhost:5173
